# --- Token Harbor ---
# Get a key at https://tokenharbor.ai/dashboard/api-keys
# Copy this file to `.env` and paste your real key. Never commit `.env`.
TH_API_KEY=thk_live_replace_me

# --- Authentication ---
# Signs the login JWTs. Any long random string works; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, a random key is used per boot and everyone is logged out on restart.
#JWT_SECRET=replace_with_a_long_random_string

# How long a login lasts, in days (default 7).
#JWT_TTL_DAYS=7

# Where the SQLite user database lives (default instance/app.db).
#TH_DB_PATH=instance/app.db

# --- Web app (optional) ---
# Model used by the Flask chat app. A `:free` id uses the free tier, so it works
# without a balance. Any id from https://tokenharbor.ai/models works.
#TH_MODEL=deepseek-v4.1-flash:free

# System prompt injected at index 0 of every conversation. Overrides the default.
#TH_SYSTEM_PROMPT=You are a friendly, concise assistant in a web chat app.

# Dev server port (default 5000).
#PORT=5000

# Set to 0 to disable Flask's debug reloader.
#FLASK_DEBUG=1
