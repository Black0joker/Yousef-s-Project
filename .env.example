# --- Token Harbor ---
# Get a key at https://tokenharbor.ai/dashboard/api-keys
# Copy this file to `.env` and paste your real key. Never commit `.env`.
TH_API_KEY=thk_live_replace_me

# --- Authentication ---
# Signs the login JWTs. Any long random string works; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, a random key is used per boot and everyone is logged out on restart.
#JWT_SECRET=replace_with_a_long_random_string

# How long a login lasts, in days (default 7).
#JWT_TTL_DAYS=7

# Where the SQLite user database lives (default instance/app.db).
#TH_DB_PATH=instance/app.db

# --- Web app (optional) ---
# Model used by the Flask chat app. A `:free` id uses the free tier, so it works
# without a balance. Any id from https://tokenharbor.ai/models works.
#TH_MODEL=deepseek-v4.1-flash:free

# System prompt injected at index 0 of every conversation. Leave unset to use the
# language-specific SAGE persona in prompts/english.md or prompts/arabic.md;
# setting it overrides the persona for every language.
#TH_SYSTEM_PROMPT=You are a friendly, concise assistant in a web chat app.

# Dev server port (default 5000).
#PORT=5000

# Set to 0 to disable Flask's debug reloader.
#FLASK_DEBUG=1

# --- Logging ---
# Defaults to readable text on stdout plus a rotating file at instance/app.log.
# Use LOG_FORMAT=json for structured production logs.
#LOG_LEVEL=INFO
#LOG_FORMAT=text
# Include normalized SQL statements (bind values only when LOG_SQL_PARAMS=1).
#LOG_SQL=1
# Dev only: also log SQL bind values, so logs show the full query with params.
# Those values are personal memory data; keep this off outside local debugging.
#LOG_SQL_PARAMS=1
# Set to an empty value to disable file logging.
#LOG_FILE=instance/app.log
#LOG_MAX_BYTES=5000000
#LOG_BACKUP_COUNT=5

# --- Voice calls (optional) ---
# ElevenApi replays the elevenlabs.io web request with a Firebase session token.
# The access token expires after about an hour; with the refresh token below it
# is renewed automatically through securetoken.googleapis.com and the rotated
# refresh token is written back here. Never commit real tokens.
#
# Preferred: paste the long-lived refresh token from DevTools
# (Application > Local Storage > firebase:authUser:... > stsTokenManager).
#ELEVENLABS_REFRESH_TOKEN=
#ELEVENLABS_UID=
# Firebase Web API key (public by design; only override if the app changes it).
#FIREBASE_API_KEY=AIzaSyBSsRE_1Os04-bxpd5JTLIniy3UK4OqKys
#
# Fallback: a short-lived access token copied from the authorization header.
#ELEVENLABS_TOKEN=eyJ...
# Regional host (default is the US cluster).
#ELEVENLABS_BASE_URL=https://api.us.elevenlabs.io
# Voice ids: friendly names come from voice.py (owl, george, host).
#ELEVENLABS_VOICE_ID=r1KmysJdVYZjJCm4mL3b
# Arabic-specific voice id (defaults to this Egyptian-friendly voice).
#ELEVENLABS_VOICE_ID_AR=L10lEremDiJfPicq5CPh
# Delivery controls (0..1): lower stability is more expressive.
#ELEVENLABS_STABILITY=0.5
#ELEVENLABS_SIMILARITY=0.75
