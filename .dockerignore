# Keep the build context small and never bake secrets or local data into the image.

.git
.gitignore
.github

# Secrets and local overrides
.env
.env.*
!.env.example

# Local data: the SQLite database and rotated logs are runtime state
instance/
*.db
*.db-journal

# Python/Docker noise
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
Dockerfile
docker-compose.yml

# Editor and tooling leftovers
.playwright-mcp/
.vscode/
.idea/
*.log
Thumbs.db
